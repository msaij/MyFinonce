# docker compose reads its secrets from .env, beside docker-compose.yml. Copy this file to
# .env (gitignored: the repository is public) and replace every change-me with a long random
# value, for example the output of: python -c "import secrets; print(secrets.token_hex(24))"
# Hex keeps a value safe inside DATABASE_URL, which compose builds from these.
#
# On a new database volume, Postgres applies these by itself on its first start. To change a
# value on an existing one (or to rotate it), edit .env and run: scripts\dev.ps1 db-role

# The Postgres superuser (mf). Nothing in the app logs in with it.
POSTGRES_PASSWORD=change-me

# The role the backend logs in as: owns the app's tables, is not a superuser.
APP_DB_USER=mf_app
APP_DB_PASSWORD=change-me

# Guards the Data Management page's write actions. Paste it into the box at the top of that page.
ADMIN_TOKEN=change-me
