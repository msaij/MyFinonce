# Data - large, regenerated by the sync daemon, not source
fetcher/data/*.duckdb
fetcher/data/*.duckdb.wal
fetcher/data/user_filters.json
backend/data/*.sqlite3
backend/data/*.sqlite3-wal
backend/data/*.sqlite3-shm
# amfi_ter_data.csv is bundled reference data, not runtime-generated -- keep it tracked
!backend/data/amfi_ter_data.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
*.tsbuildinfo

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code runtime
.claude/scheduled_tasks.lock
